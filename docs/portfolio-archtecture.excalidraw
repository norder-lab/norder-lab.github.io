    {
      "id": "s3Gad8LLMZFHqkeeI2WRW",
      "type": "text",
      "x": 2928.161428240911,
      "y": -2121.9144353490065,
      "width": 252.97598266601562,
      "height": 840,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
